# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is already in .gitignore.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...your-key-here...

# Model to use for analysis (change to gpt-4o-mini to reduce cost while testing)
OPENAI_MODEL=gpt-4o

# ── Cost tracking (USD per million tokens) ────────────────────────────────────
# Check current prices at https://openai.com/api/pricing
# Defaults match gpt-4o pricing as of 2025 — update if you switch models.
MODEL_INPUT_PRICE_PER_MILLION=5.00
MODEL_OUTPUT_PRICE_PER_MILLION=15.00
